<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>mqcache-server</AssemblyName>
    <RootNamespace>MQCache.Server</RootNamespace>
    <Description>MQCache server: Redis-like cache served over Microsoft Message Queuing. Console app and Windows Service.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Copyright>Copyright © 2026 Hadi Cahyadi</Copyright>
    <Authors>Hadi Cahyadi</Authors>
    <Company>cumulus13</Company>
    <RepositoryBranch>master</RepositoryBranch>
    <PackageId>MQCache-server</PackageId>
    <Product>MQCache Server</Product>
    <Version>1.0.0</Version>
    <PackageTags>mqcache msmq caching redis queue windows-service</PackageTags>
    <PackageProjectUrl>https://github.com/cumulus13/mqcache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cumulus13/mqcache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MQCache.Core\MQCache.Core.csproj" />
    <ProjectReference Include="..\MQCache.Messaging\MQCache.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\conf\mqcache.conf" Link="mqcache.conf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
