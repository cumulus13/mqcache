<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MQCache.Messaging</RootNamespace>
    <Description>MSMQ plumbing shared by the MQCache server and client: endpoints, queue administration, message factory.</Description>
    <Copyright>Copyright © 2026 Hadi Cahyadi</Copyright>
    <Authors>Hadi Cahyadi</Authors>
    <Company>cumulus13</Company>
    <RepositoryBranch>master</RepositoryBranch>
    <PackageId>MQCache-messaging</PackageId>
    <Product>MQCache Messaging</Product>
    <Version>1.0.0</Version>
    <PackageTags>mqcache msmq caching redis queue windows-service</PackageTags>
    <PackageProjectUrl>https://github.com/cumulus13/mqcache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cumulus13/mqcache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Experimental.System.Messaging" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MQCache.Core\MQCache.Core.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
